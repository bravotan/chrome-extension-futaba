{
  "manifest_version": 3,
  "name": "ふたばちゃんねる支援ツール",
  "version": "0.1.0",
  "description": "ふたばちゃんねる(2chan.net)PC版に情報表示用パネルをiframeで追加する拡張機能",
  "content_scripts": [
    {
      "matches": ["*://*.2chan.net/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel/panel.html",
        "panel/panel.css",
        "panel/panel.js",
        "panel/colors.js"
      ],
      "matches": ["*://*.2chan.net/*"]
    }
  ]
}
